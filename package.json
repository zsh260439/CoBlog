{
  "name": "co-blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "setup": "pnpm --dir apps/server install && pnpm --dir apps/client install",
    "dev": "concurrently \"pnpm --dir apps/server dev\" \"pnpm --dir apps/client dev\"",
    "dev:client": "pnpm --dir apps/client dev",
    "dev:server": "pnpm --dir apps/server dev",
    "build": "pnpm run build:server && pnpm run build:client",
    "build:client": "pnpm --dir apps/client build",
    "build:server": "pnpm --dir apps/server build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
